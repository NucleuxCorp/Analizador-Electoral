# ---------------------------------------------------------------------------
# .env.example -- copy to .env and fill in real values for local development.
# On Railway these are set as platform environment variables.
# ---------------------------------------------------------------------------

# --- Supabase (required in multi-user mode) ---------------------------------

# Project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=

# Public anon key from Supabase dashboard -> Settings -> API
SUPABASE_ANON_KEY=

# --- Flask ------------------------------------------------------------------

# Random secret used to sign session cookies.
SECRET_KEY=

# --- Storage / paths --------------------------------------------------------

# Root directory for label data (crops/, manifest.jsonl, etc.)
# Defaults to data/labels when unset.
LABELS_DIR=data/labels

# Set to true to redirect /image/<id> to Supabase Storage.
USE_SUPABASE_STORAGE=false

# --- reCAPTCHA Enterprise (protect auth forms from bots) --------------------

# Get site key from Google Cloud Console → reCAPTCHA.
# Project ID is your Google Cloud project name/ID (visible in the top bar).
# API Key is created under APIs y Servicios → Credenciales → Crear → Clave de API.
# All three must be set for verification to work.
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=

# --- Dev bypass (ADR-4) -----------------------------------------------------

# Synthetic user_id used when SUPABASE_URL is unset (local single-user mode).
FAKE_USER_ID=dev-user
